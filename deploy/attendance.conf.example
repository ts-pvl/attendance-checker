# /etc/attendance/attendance.conf — QR attendance server.
# "key = value"; unknown keys are an error. Durations: 30s, 3m, 2h. Times: HH:MM.

listen = 0.0.0.0:8080
db = /var/lib/attendance/attendance.db
timezone = Asia/Almaty
# Language of the bot, the QR page and the admin UI: ru or en.
lang = ru

# The bot's @username (without @). It goes into every QR code and enrollment link.
bot_username = MySchoolAttendanceBot
# Secrets. Under systemd these default to the LoadCredential copies, so you
# normally leave them commented out.
#bot_token_file = /etc/attendance/bot_token
#host_key_file = /etc/attendance/host_key
token_secret_file = /var/lib/attendance/token_secret

# Lab PCs: "name,ip" lines, generated by Ansible from the inventory.
hosts_file = /etc/attendance/hosts.csv

# Who may open the admin UI (comma-separated CIDRs). Lab PCs are refused
# even inside these networks unless admin_from_lab_pcs = true.
admin_networks = 127.0.0.0/8, 192.168.0.0/16, 10.0.0.0/8
admin_from_lab_pcs = false

# QR codes rotate every qr_rotate and are accepted for qr_token_ttl after
# they appear (Telegram adds a second or two). Max 2m.
qr_rotate = 30s
qr_token_ttl = 60s
# A PC that sends nothing for this long is treated as switched off.
heartbeat_timeout = 3m
# /checkout uses the current time if the PC was active this recently, else the last activity.
checkout_slack = 2m
enroll_code_ttl = 336h

# Nightly jobs (local time). The cleanup closes every visit still open.
cleanup_at = 04:00
backup_at = 03:30
backup_dir = /var/backups/attendance
backup_keep_days = 14
# Delete raw heartbeat events older than this many days (0 = keep forever).
# Replay of older history then loses timeout precision.
heartbeat_retention_days = 0

staff_session_idle = 2h
staff_session_max = 12h

# How hours are counted (0 = off). Default: exact minutes.
hours_rounding = 0
hours_min_visit = 0
hours_daily_cap = 0

# Anomaly list thresholds.
anomaly_latency = 45s
anomaly_multi_pc = 15m
# /healthz (and the alert script) turn red after this long without heartbeats
# (only if the last PC session timed out) or without contact with Telegram.
alert_after = 15m
